# Managed-by: esforzados-legal-preview
[Unit]
Description=Esforzados Legal - publicador de releases
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/www/legal/.legal-managed

[Service]
Type=oneshot
User=legal-deploy
Group=legal-deploy
ExecStart=/usr/local/libexec/legal-update
WorkingDirectory=/var/lib/legal
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/legal /var/www/legal
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
